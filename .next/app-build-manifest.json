      "static/chunks/app/(rs)/template.js"
    ],
    "/(rs)/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(rs)/error.js"
    ],
    "/(rs)/home/page": [
      "static/chunks/webpack.js",
